# ─────────────────────────────────────────────────────────────────────────────
# Phase 8 — LLM agents.  Copy to `.env` (git-ignored) and fill in as needed.
# The entire test suite and a full offline demo run with NOTHING set here.
# ─────────────────────────────────────────────────────────────────────────────

# LLM_MODE selects the backend:
#   mock     — canned deterministic responses, no network, no key (DEFAULT).
#              This is what `pytest` uses.
#   live     — Groq free tier. Needs GROQ_API_KEY. Subject to the token budget.
#   offline  — a local Ollama server (LLM_MODE=offline). Zero rate limit.
LLM_MODE=mock

# Groq API key (https://console.groq.com/keys). Free tier. Leave BLANK for mock.
# ⚠️ Free-tier limits are per ORGANISATION — extra keys do not add capacity.
GROQ_API_KEY=

# Local Ollama endpoint, used only when LLM_MODE=offline.
OLLAMA_HOST=http://localhost:11434

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: model IDs are NOT set here on purpose.  `llama-3.3-70b-versatile` and
# `llama-3.1-8b-instant` were reportedly deprecated 2026-06-17.  The fallback
# chains live in `src/config.py` (LLM_MODEL_CHAINS) and are probed at startup —
# never hard-code a model ID.
# ─────────────────────────────────────────────────────────────────────────────
